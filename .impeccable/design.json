  "narrative": {
    "northStar": "Магазин в кармане",
    "overview": "Главный герой каждого экрана — телефон и то, что происходит на нём под пальцем. Интерфейс сделан как предмет, который приятно трогать: пухлые кнопки с подложкой, мягкое стекло, скруглённые как у телефона углы, а вокруг парят пластилиновые предметы из мира магазина. Мир один на все поверхности: лендинг, витрина и админка одинаково яркие; меняется только плотность.",
    "keyCharacteristics": [
      "Сиреневое поле как основа каждой страницы, контент на белой бумаге или стекле.",
      "Пухлые кнопки-«пилюли» с плотной цветной подложкой снизу, которые проседают при нажатии.",
      "Матовое стекло для навигации, панелей и вопросов.",
      "Парящие пластилиновые предметы как фирменный знак.",
      "Один шрифт Geologica, жирные заголовки с плотным трекингом.",
      "Цвет наличия всегда одинаковый: зелёный «есть», янтарный «мало», серо-сиреневый «нет»."
    ],
    "rules": [
      { "name": "The Underside Rule", "body": "Каждая залитая кнопка и каждый яркий блок имеют подложку — более тёмный тон своего цвета, сдвинутый вниз без размытия.", "section": "colors" },
      { "name": "The One Sun Rule", "body": "Жёлтый — одна главная кнопка на экран.", "section": "colors" },
      { "name": "The Status Is Sacred Rule", "body": "Зелёный, янтарный и серо-сиреневый означают наличие и ничего больше.", "section": "colors" },
      { "name": "The AA Rule", "body": "Мелкий текст — только цвета, проходящие 4.5:1 на своём фоне.", "section": "colors" },
      { "name": "The Tight Heads Rule", "body": "Чем крупнее заголовок, тем плотнее трекинг.", "section": "typography" },
      { "name": "The Tabular Money Rule", "body": "Все цены и суммы — табличными цифрами с пробелом между разрядами.", "section": "typography" },
      { "name": "The Phone Is The Unit Rule", "body": "Ключевая демонстрация помещается в один экран телефона; если нет — вкладки.", "section": "layout" },
      { "name": "The Press Rule", "body": "При нажатии кнопка опускается на высоту подложки, при наведении приподнимается на 3px с пружиной.", "section": "elevation" },
      { "name": "The Nested Radius Rule", "body": "Внутренний радиус равен внешнему минус отступ.", "section": "shapes" }
    ],
    "dos": [
      "Do держать сиреневое поле фоном каждой поверхности, а данные — на белом или бумаге.",
      "Do давать каждой залитой кнопке подложку её тона.",
      "Do показывать наличие цветом и текстом вместе: «Осталось 1».",
      "Do ставить предметы в поля, шапки секций, пустые состояния и экраны успеха.",
      "Do на телефоне превращать параллельные сцены во вкладки.",
      "Do задавать цвета через токены, чтобы позже добавить тёмную тему без переделки."
    ],
    "donts": [
      "Don't делать «базарно»: никаких кричащих скидочных плашек, мигания, красного «SALE».",
      "Don't делать скучно-корпоративно: никаких серых плоских кнопок без подложки и серых теней.",
      "Don't ставить парящие предметы поверх таблиц, форм, цен и кнопок.",
      "Don't использовать больше одной жёлтой кнопки на экране.",
      "Don't использовать мятный, янтарный или зелёный не по назначению.",
      "Don't использовать светлые сиреневые серые для текста меньше 18px."
    ]
  }
