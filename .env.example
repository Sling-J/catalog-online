# Скопируйте в .env и при необходимости поменяйте. .env в git не попадает.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_PORT=5432
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog

# S3-совместимое хранилище (в разработке — SeaweedFS, ключи из infra/dev/seaweedfs-s3.json)
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=catalog-dev
S3_SECRET_KEY=catalog-dev-secret
S3_BUCKET=catalog

# API (apps/api, T-401): читает этот файл из корня в `pnpm dev` / `pnpm start`; проверка — src/core/config
# NODE_ENV=development   # development | test | production
API_PORT=3001
# Адреса фронтов для CORS через запятую; * — любой поддомен (витрины)
CORS_ORIGINS=http://app.localhost:3002,http://localhost:3000,http://*.localhost:3000
LOG_LEVEL=debug   # fatal | error | warn | info | debug | trace | silent
# TRUST_PROXY=1   # сколько прокси перед API (Caddy в продакшене — 1); по умолчанию 0

# Фронты (apps/web, apps/admin): в разработке запросы к API перехватывает MSW; VITE_API_MOCKS=off отключает моки,
# VITE_API_URL задаёт адрес настоящего API
# VITE_API_MOCKS=off
# VITE_API_URL=http://localhost:3001
# VITE_ROOT_DOMAIN=localhost   # основной домен: лендинг на нём, витрины на <поддомен>.<домен>
# VITE_ADMIN_ORIGIN=http://app.localhost:3002   # адрес админки: регистрация с лендинга и правки превью; по умолчанию app.<домен> (в разработке — порт 3002)
# VITE_STOREFRONT_PORT=3000   # порт витрин для ссылок из админки; по умолчанию в разработке 3000, в продакшене без порта
# VITE_DEMO_SHOP=aigerim-kids   # поддомен демо-магазина для «Посмотреть пример» на лендинге
