# Скопируйте в .env и при необходимости поменяйте. .env в git не попадает.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_PORT=5432
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog

# S3-совместимое хранилище (в разработке — SeaweedFS, ключи из infra/dev/seaweedfs-s3.json)
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=catalog-dev
S3_SECRET_KEY=catalog-dev-secret
S3_BUCKET=catalog

# Фронты (apps/web): в разработке запросы к API перехватывает MSW; VITE_API_MOCKS=off отключает моки,
# VITE_API_URL задаёт адрес настоящего API
# VITE_API_MOCKS=off
# VITE_API_URL=http://localhost:3001
# VITE_ROOT_DOMAIN=localhost   # основной домен: лендинг на нём, витрины на <поддомен>.<домен>
