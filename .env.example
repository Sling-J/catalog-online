# Скопируйте в .env и при необходимости поменяйте. .env в git не попадает.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_PORT=5432
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog

# S3-совместимое хранилище (в разработке — SeaweedFS, ключи из infra/dev/seaweedfs-s3.json)
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=catalog-dev
S3_SECRET_KEY=catalog-dev-secret
S3_BUCKET=catalog
