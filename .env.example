# Скопируйте в .env и при необходимости поменяйте. .env в git не попадает.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_PORT=5432
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog

# S3-совместимое хранилище (в разработке — SeaweedFS, ключи из infra/dev/seaweedfs-s3.json)
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=catalog-dev
S3_SECRET_KEY=catalog-dev-secret
# Два хранилища (T-405): публичное — готовые фото и логотипы, закрытое — исходники и файлы импорта
S3_PUBLIC_BUCKET=catalog-public
S3_PRIVATE_BUCKET=catalog-private
# Адрес публичного хранилища для покупателей (в продакшене — CDN)
S3_PUBLIC_URL=http://localhost:8333/catalog-public

# API (apps/api, T-401): читает этот файл из корня в `pnpm dev` / `pnpm start`; проверка — src/core/config
# NODE_ENV=development   # development | test | production
API_PORT=3001
# Адреса фронтов для CORS через запятую; * — любой поддомен (витрины)
CORS_ORIGINS=http://app.localhost:3002,http://localhost:3000,http://*.localhost:3000
LOG_LEVEL=debug   # fatal | error | warn | info | debug | trace | silent
# TRUST_PROXY=1   # сколько прокси перед API (Caddy в продакшене — 1); по умолчанию 0
# Адрес админки для ссылок в письмах (подтверждение почты, новый пароль)
ADMIN_URL=http://app.localhost:3002
# COOKIE_DOMAIN=.example.kz   # общий домен админки и API для cookie сессии (продакшен); в разработке не нужен
# SMTP_URL=smtp://user:pass@smtp.example.kz:587   # пусто — письма пишутся в лог API
# MAIL_FROM="Каталог <no-reply@example.kz>"
# Секрет подписи токенов (превью витрины), не короче 32 символов; в продакшене — свой случайный
APP_SECRET=dev-secret-change-me-in-production-0000
# MAIL_OUTBOX_DIR=.mail   # только разработка и e2e: письма — JSON-файлами в эту папку вместо лога; в продакшене API не стартует
# RATE_LIMITS=off        # только разработка и e2e: без ограничений частоты; в продакшене API не стартует

# Фронты (apps/web, apps/admin): в разработке ходят в настоящий API (T-501). Моки MSW — режимом `vite --mode mocks`
# (файлы apps/*/.env.mocks: VITE_API_MOCKS=on). Админка в разработке шлёт запросы на свой адрес, Vite пересылает /v1
# на API (переменная оболочки API_PROXY_TARGET, по умолчанию http://localhost:3001); витрина — прямо на API.
# VITE_API_URL=http://localhost:3001   # адрес API; в продакшене обязателен для обоих фронтов
# VITE_ROOT_DOMAIN=localhost   # основной домен: лендинг на нём, витрины на <поддомен>.<домен>
# VITE_ADMIN_ORIGIN=http://app.localhost:3002   # адрес админки: регистрация с лендинга и правки превью; по умолчанию app.<домен> (в разработке — порт 3002)
# VITE_STOREFRONT_PORT=3000   # порт витрин для ссылок из админки; по умолчанию в разработке 3000, в продакшене без порта
# VITE_DEMO_SHOP=aigerim-kids   # поддомен демо-магазина для «Посмотреть пример» на лендинге
