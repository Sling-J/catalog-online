{
  // Проверка типов всего пакета: код, тесты, конфиги. Сборка — tsconfig.build.json.
  "extends": "@catalog/tsconfig/node.json",
  "compilerOptions": {
    // Декораторы Nest и метаданные типов для внедрения зависимостей (ADR 0004)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts", "drizzle.config.ts"]
}
