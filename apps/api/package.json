{
  "name": "@catalog/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@catalog/tsconfig": "workspace:*",
    "@nestjs/testing": "12.3.3",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0"
  },
  "dependencies": {
    "@catalog/contract": "workspace:*",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/throttler": "6.7.1",
    "drizzle-orm": "0.45.4",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
